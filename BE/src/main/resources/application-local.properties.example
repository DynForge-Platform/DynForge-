# ==============================================================================
# DynForge Local Development Configuration (Example Template)
# ==============================================================================
# Instructions:
# 1. Copy this file to 'application-local.properties' in the same directory:
#    cp application-local.properties.example application-local.properties
# 2. Fill in your own local credentials/keys below.
# 3. 'application-local.properties' is ignored by Git and will NEVER be committed.
# ==============================================================================

# Database (optional override)
# spring.data.mongodb.uri=mongodb://localhost:27017/dynforge

# Security / JWT (Base64-encoded secret key, minimum 256 bits)
app.jwt.secret=YOUR_BASE64_ENCODED_JWT_SECRET_HERE

# Webhook Secret (Must NOT be default placeholder in production)
app.webhook.secret=YOUR_CUSTOM_WEBHOOK_SECRET_HERE

# OTP Secret for HMAC-SHA256 hashing
app.otp.secret=YOUR_CUSTOM_OTP_SECRET_KEY_HERE

# Brevo Transactional Email Relay (SMTP)
spring.mail.username=YOUR_BREVO_SMTP_USERNAME
spring.mail.password=YOUR_BREVO_SMTP_PASSWORD
app.mail.from=your-sender-email@domain.com
app.mail.sender-name=DynForge Support

# Google Gemini AI API Key (from Google AI Studio)
gemini.api-key=YOUR_GEMINI_API_KEY_HERE

# PayOS Payment Gateway
payos.client-id=YOUR_PAYOS_CLIENT_ID_HERE
payos.api-key=YOUR_PAYOS_API_KEY_HERE
payos.checksum-key=YOUR_PAYOS_CHECKSUM_KEY_HERE
